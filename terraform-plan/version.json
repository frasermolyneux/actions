{
    "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/master/src/NerdBank.GitVersioning/version.schema.json",
    "version": "5.0",
    "inherit": false,
    "pathFilters": [
        "../terraform-plan/**",
        "../terraform-setup/**",
        "../terraform-receipt/**",
        "../terraform-plan-storage/**",
        "../terraform-pr-comment/**"
